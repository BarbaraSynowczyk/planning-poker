<div class="container vh-100 d-flex flex-column justify-content-center align-items-center">

    <div class="mx-2 my-3">
        <img src="/images/logo.png" id="logo">
    </div>

    <form method="POST" autocomplete="on" action="/login" class="w-75 d-flex flex-column align-items-center">

        {{> login/input
                type="text"
                name="domain"
                placeholder="Enter domain"
                value="basiasynowczyk.atlassian.net"
                autocomplete="off"
                icon="🌐"
                id="domain"
        }}

        {{> login/input
                type="email"
                name="email"
                placeholder="Enter your email"
                autocomplete="email"
                icon="@"
                id="email"
        }}

        {{> login/input
                type="password"
                name="password"
                placeholder="Enter token"
                autocomplete="current-password"
                icon="🔑"
                id="password"
        }}

        <button type="submit" id="btn" class="btn  my-4 text-nowrap text-light fs-5 w-50 d-flex justify-content-center align-items-center gap-2 p-2">
            <span><img src="/images/jira_logo.png" id="logo_jira"/></span>Login with Jira
        </button>

        {{> login/loginError error=error}}

    </form>
</div>