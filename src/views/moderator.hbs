<div class="container-fluid" >
    {{>topbar
        avatar=avatar
        userName=userName
    }}
    <div class="select-bar rounded-3 my-4">
        <div
                class="d-flex align-items-center justify-content-between"
        >
            <div class="select-left">
                {{> moderator/filterBar filters=filters}}
                {{> moderator/jqlSnippet jql=jql}}
            </div>
            <div class="select-right" id="session-link-wrapper">
                {{> moderator/sessionLink}}
            </div>
        </div>
    </div>
    <div class="container-fluid main-layout">
        <div class="row g-4"  >
            {{> moderator/kanban/kanban features=features}}

            <div id="ticketPreview" class="col-12 col-xl-3 ticket-preview">
                {{> moderator/ticketPreview task=activeTask}}
            </div>
        </div>
    </div>
</div>