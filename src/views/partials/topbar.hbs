<div class="row align-items-center my-5 ">
    <div class="col-auto d-flex align-items-center gap-4">
        <img src="/images/logo_without_title.png" id="logo_without_title"/><h4 class="text-white">Planning Poker Session</h4></div>
    <div

            id="user"
            data-avatar="{{avatar}}"
            data-user="{{userName}}"
            class="col-auto ms-auto d-flex align-items-center gap-2">
        <img id="userImage" src="{{avatar}}" alt="avatar_image">
            <h5 class="text-secondary m-0">{{userName}}</h5>
    </div>
</div>