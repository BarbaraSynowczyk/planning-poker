<div id="ticketPreview" class="col-12 col-xl-3 ticket-preview">

    <button class="close-preview" id="closePreview">✕</button>

    <h4 class="preview-title">Active ticket preview</h4>

    <div class="ticket-header">
        <div class="ticket-id fs-4 fw-semibold">
            {{#if task}}{{task.key}}{{/if}}
        </div>

        <div class="ticket-name fs-6 text-light">
            {{#if task}}{{task.name}}{{/if}}
        </div>

        <span class="ticket-status fw-semibold fs-6">
            {{#if task}}{{task.status}}{{/if}}
        </span>
    </div>

    <div class="ticket-meta">
        <div class="ticket-left">
            <div class="story-points">
                <b class="text-secondary fs-6">
                    Story Points:
                    {{#if task}}
                        {{#if task.storyPoints}}{{task.storyPoints}}{{else}}-{{/if}}
                    {{/if}}
                </b>
            </div>
        </div>

        <div class="ticket-right text-light">
            <div class="my-2 created">
                <span class="text-white fs-6">Created:</span>
                {{#if task}}
                    {{formatDate task.created}}
                {{/if}}
            </div>
            <div class="my-2 updated">
                <span class="text-white fs-6">Updated:</span>
                {{#if task}}
                    {{timeAgo task.updated}}
                {{/if}}
            </div>
            <div class="my-2 date">
                <span class="text-white fs-6">Date:</span>
                {{#if task}}
                    {{#if task.dueDate}}
                        {{formatDate task.dueDate}}
                    {{else}}
                        No due date
                    {{/if}}
                {{/if}}
            </div>
        </div>
    </div>

    <div class="ticket-description text-secondary">
        {{#if task}}
            {{#if task.description}}{{{task.description}}}{{else}}No description{{/if}}
        {{/if}}
    </div>
    <div class="ticket-comments">
        {{#if task}}
                {{> comment comments=task.comments}}
        {{/if}}
    </div>
</div>