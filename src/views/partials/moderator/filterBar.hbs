<div class="jira-dropdown">
    <button class="jira-dropdown-btn">
        <span class="selected fs-5">Select Filter</span>
        <span class="arrow"></span>
    </button>

    <div class="jira-dropdown-menu custom-scrollbar">
        <form data-on:submit="@post('/filter', {contentType: 'form'})">
            <input type="hidden" name="jql" value="ALL">
            <button type="submit" class="jira-option">Show all</button>
        </form>

        {{#each filters}}
            <form data-on:submit="@post('/filter', {contentType: 'form'})">
                <input type="hidden" name="jql" value="{{jql}}">
                <button type="submit" class="jira-option">{{name}}</button>
            </form>
        {{/each}}
    </div>
</div>