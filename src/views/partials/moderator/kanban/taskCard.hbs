<form
        class="task-card"
        data-signals:_previewRequested="false"
        data-on:click="
        $_previewRequested = true;
        @post('/create-session', {contentType: 'form'})
    "
        data-on:datastar-fetch="
    evt.detail.type === 'finished' &&
    evt.detail.el === el &&
    $_previewRequested &&
    ($_previewRequested = false, @get('/task-preview/{{key}}'))
"
>
    <input type="hidden" name="taskKey" value="{{key}}">
    <div class="fs-5 text-light fw-semibold">
        {{key}}
    </div>
    <div class="my-3 text-light">
        {{name}}
    </div>
    <div class="task-footer">
        {{#each labels}}
            <span class="bg-warning tag fw-semibold">{{this}}</span>
        {{/each}}

        <span class="points">
            {{storyPoints}}
        </span>
    </div>
</form>
