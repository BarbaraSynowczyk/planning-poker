<div class="table-container" data-merge="outerHTML" id="game-state" style="--count: {{players.length}}">

    <div class="table-center">
        {{#if revealed}}
            Votes revealed
        {{else}}
            Waiting for players votes...
        {{/if}}
    </div>

    {{#each players}}
        <div class="player-seat" style="--i: {{@index}}">

            <div class="player-card text-white">

                {{#if ../revealed}}
                    {{this.vote}}
                {{else}}
                    {{#if this.vote}}
                        ✔
                    {{else}}
                        ?
                    {{/if}}
                {{/if}}

                <span class="dot"></span>
            </div>

            <div class="player-name text-white my-2">
                {{this.name}}
            </div>

        </div>
    {{/each}}

</div>