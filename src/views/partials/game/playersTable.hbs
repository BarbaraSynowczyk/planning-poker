<div class="table-container" style="--count: {{players.length}}">

    <div class="table-center">
        {{#if revealed}}
            Votes revealed
        {{else}}
            <div class="waiting">
                Waiting for votes... ({{notVoted}} left)
            </div>
        {{/if}}
    </div>

    <div class="table-players">
        {{#each players}}
            <div class="player-seat" style="--i: {{@index}}">
                <div class="player-card text-white">
                    {{#if ../revealed}}
                        {{#if (eq this.vote "coffee")}}
                            ☕
                        {{else if (eq this.vote "question")}}
                            ❓
                        {{else}}
                            {{this.vote}}
                        {{/if}}
                    {{else}}
                        {{#if this.vote}}
                            ✔
                        {{else}}
                            ?
                        {{/if}}
                    {{/if}}
                    <span class="dot"></span>
                </div>

                <div class="player-name text-white my-2">
                    {{this.name}}
                </div>
            </div>
        {{/each}}
    </div>
</div>
