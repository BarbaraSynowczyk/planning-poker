<div class="table-container" style="--count: {{players.length}}">

    <div class="table-center">
        Waiting for players votes...
    </div>

    {{#each players}}
        <div class="player-seat" style="--i: {{@index}}">
            <div class="poker-card">
                ?
                <span class="dot"></span>
            </div>
            <div class="player-name text-white my-2">{{name}}</div>
        </div>
    {{/each}}

</div>