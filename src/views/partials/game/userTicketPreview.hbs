<div id="task-container" data-merge="outerHTML">
    <div class="game-ticket-preview" id="task-container" >
    <div class="preview-header d-flex justify-content-between align-items-center">
        <div>
            <span class="ticket-id">{{task.key}}</span>
            <span class="ticket-title">{{task.name}}</span>
        </div>
        <span class="ticket-status">{{task.status}}</span>
    </div>
    <hr />
    <div class="preview-body d-flex justify-content-between">
        <div class="preview-left">
            <h6 class="text-secondary ">Description</h6>

            <div class="ticket-description scrollable">
                {{#if task.description}}
                    {{{task.description}}}
                {{else}}
                    No description
                {{/if}}
            </div>
        </div>
        <div class="preview-right">
            <div><b >Created:</b> {{formatDate task.created}}</div>
            <div><b>Updated:</b> {{timeAgo task.updated}}</div>
            <div>
                <b>Date:</b>
                {{#if task.dueDate}}
                    {{formatDate task.dueDate}}
                {{else}}
                    -
                {{/if}}
            </div>
        </div>
    </div>
    <div class="preview-comments scrollable">
        {{#if task.comments.length}}
            {{> comment comments=task.comments}}
        {{/if}}
    </div>

</div>
</div>