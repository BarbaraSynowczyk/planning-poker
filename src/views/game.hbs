<div class="container" data-session-id="{{sessionId}}" id="game-root" data-init="@get('/game/updates')" data-signals='{
  "selectedTaskId": "{{activeTask.key}}"
}'>
    <div>
        {{>topbar
                avatar=avatar
                userName=userName
        }}
        <div class="row">
            <div class="col-7" >
                <div id="game-state" data-merge="outerHTML" >
                    {{> game/playersTable players=players}}
                </div>
                <div>
                    <hr class="text-secondary"/>
                    <p class="text-secondary text-center fs-5">Pick one card</p>
                    <div id="cards">
                        {{#each cards}}
                            {{> card n=this userName=userName}}
                        {{/each}}
                    </div>
                </div>
            </div>
            <div class="col-5 d-flex justify-content-center">
                <div class="preview-wrapper">
                    {{> moderator/ticketPreview task=activeTask}}
                </div>
            </div>
        </div>
    </div>
</div>